# Server port
PORT=4000

# Secret used to sign JWT access tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret

# How long issued tokens remain valid (zeit/ms format, e.g. 15m, 7d).
JWT_EXPIRES_IN=7d

# Path to the SQLite database file. Use ":memory:" for an ephemeral DB.
DATABASE_PATH=./data/app.sqlite

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGIN=http://localhost:5173
